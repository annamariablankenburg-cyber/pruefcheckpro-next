rules_version = '2';

// Security Rules für die bereits real angebundenen Vertical Slices (siehe
// docs/firebase/customer-firestore-slice.md,
// docs/firebase/project-firestore-slice.md,
// docs/firebase/device-firestore-slice.md,
// docs/firebase/sample-firestore-slice.md und
// docs/firebase/test-values-firestore-slice.md). Bewusst restriktiv: nur
// Collections mit echter Firestore-Anbindung werden geöffnet, alles andere
// bleibt per Fallback gesperrt. Kein "allow read, write: if true" irgendwo
// in diesem Projekt.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Security Foundations (siehe docs/firebase/security-foundations.md) ---
    //
    // Die Firmenzugehörigkeit kommt AUSSCHLIESSLICH aus
    // userMemberships/{request.auth.uid}. users/{uid} ist das clientseitig
    // verwaltete Login-Profil; dessen Felder (role, companyId, plan …) werden
    // hier NIE für die Autorisierung ausgewertet.
    //
    // Zugriff auf companies/{companyId}/... nur, wenn
    //   - der Nutzer angemeldet ist,
    //   - ein Membership-Dokument existiert,
    //   - membership.companyId == companyId UND
    //   - membership.status == "Aktiv".
    // Fehlende Felder führen über .get(key, default) zu "kein Zugriff", nie zu
    // einem Fehler mit Fallback. Das Membership-Dokument wird pro Request nur
    // einmal gelesen (wiederholte get() auf dasselbe Dokument zählen einmal).
    //
    // BEWUSST NOCH KEINE rollenbasierte Durchsetzung: roleId/role der
    // Membership werden hier nicht ausgewertet (kein "roleId == admin", keine
    // Permission-Dokumente). Das folgt in einem eigenen Security-Slice.
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/userMemberships/$(request.auth.uid);
    }

    function belongsToCompany(companyId) {
      return isSignedIn() &&
        exists(membershipPath()) &&
        get(membershipPath()).data.get("companyId", "") == companyId &&
        get(membershipPath()).data.get("status", "") == "Aktiv";
    }

    // Membership-Dokument: der eigene Nutzer darf es LESEN (einzelnes Dokument,
    // kein Auflisten). Es gibt KEINEN Client-Write (create/update/delete): die
    // Zuordnung zu Firma/Mitarbeiter/Rolle/Status wird nicht von der App
    // gesetzt. Provisionierung braucht eine Server-Komponente (Admin SDK), die
    // die Rules umgeht – hier nicht implementiert. Im lokalen Emulator seeden
    // siehe scripts/seedUserMemberships.ts.
    match /userMemberships/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Login-Profil (AppUser, siehe src/lib/firebase/users.ts). KEINE
    // Sicherheitsquelle: Felder wie role/plan/companyId werden nirgends für die
    // Autorisierung ausgewertet (siehe oben). Trotzdem sind role/plan
    // Produkt-/Profilmetadaten und daher für den Client nicht frei änderbar.
    //
    // Der Client braucht genau zwei Schreibvorgänge (users.ts):
    //   1. createUserProfile(): einmalig bei der Registrierung ein festes
    //      Basisprofil (role "azubi", plan "azubi", serverTimestamp für
    //      createdAt/lastLogin),
    //   2. updateLastLogin(): beim Login NUR lastLogin.
    // Deshalb: Einzeldokument-Lesen nur für den eigenen User (kein list), Create
    // nur mit exakt diesem Basismodell, Update nur lastLogin, kein Löschen.
    // firstName/lastName/language/theme werden heute clientseitig nirgends
    // geändert und sind deshalb nicht änderbar; email ebenso (kein Profil-Sync).
    function isValidNewProfile(uid) {
      let fields = ["id", "firstName", "lastName", "email", "role", "plan",
                    "language", "theme", "createdAt", "lastLogin"];
      let data = request.resource.data;
      return data.keys().hasOnly(fields) &&
        data.keys().hasAll(fields) &&
        data.id == uid &&
        data.firstName is string &&
        data.lastName is string &&
        data.email is string &&
        data.role == "azubi" &&
        data.plan == "azubi" &&
        data.language in ["de", "en"] &&
        data.theme in ["light", "dark", "system"] &&
        data.createdAt == request.time &&
        data.lastLogin == request.time;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == uid && isValidNewProfile(uid);
      // Nur lastLogin darf sich ändern (und nur auf die Serverzeit). id, email,
      // role, plan, companyId, laboratoryId, createdAt, firstName, lastName,
      // language, theme bleiben unveränderlich.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastLogin"]) &&
        request.resource.data.lastLogin == request.time;
      allow delete: if false;
    }

    match /companies/{companyId}/customers/{customerId} {
      // Angemeldet + eigene companyId. Keine rollenabhängige Einschränkung
      // (Admin/Laborleiter vs. Prüfer/Azubi/Gast, siehe
      // docs/database/permissions.md Abschnitt 3 "Kunden erstellen/bearbeiten/
      // löschen") – dafür fehlen heute noch die Custom Claims. Bis dahin
      // bewusst restriktiv auf "eigene Firma", nicht auf "jeder darf alles"
      // (siehe docs/firebase/customer-firestore-slice.md, "Bekannte offene
      // Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/projects/{projectId} {
      // Gleiches Muster wie companies/{companyId}/customers: angemeldet +
      // eigene companyId. Lesen ist für alle Unternehmensmitglieder gedacht
      // (siehe docs/database/permissions.md, "Projekte ansehen" ist bei allen
      // 5 Kernrollen erlaubt); Schreiben ist heute ebenfalls für jeden
      // angemeldeten Nutzer der eigenen Firma offen, da noch keine Custom
      // Claims für eine rollenabhängige Einschränkung existieren (nur
      // Admin/Laborleiter dürften laut Rechte-Matrix erstellen/bearbeiten/
      // löschen). Bis dahin bewusst restriktiv auf "eigene Firma", nicht auf
      // "jeder darf alles" (siehe docs/firebase/project-firestore-slice.md,
      // "Bekannte offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/devices/{deviceId} {
      // Gleiches companyId-Muster wie companies/{companyId}/customers und
      // .../projects: angemeldet + eigene companyId. Lesen ist für alle
      // Unternehmensmitglieder gedacht (siehe docs/database/permissions.md,
      // "Geräte ansehen" ist bei allen 5 Kernrollen erlaubt); Schreiben ist
      // heute ebenfalls für jeden angemeldeten Nutzer der eigenen Firma
      // offen, da noch keine Custom Claims für eine rollenabhängige
      // Einschränkung existieren (nur Admin/Laborleiter dürften laut
      // Rechte-Matrix Geräte bearbeiten). Bis dahin bewusst restriktiv auf
      // "eigene Firma", nicht auf "jeder darf alles" (siehe
      // docs/firebase/device-firestore-slice.md, "Bekannte offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/samples/{sampleId} {
      // Gleiches companyId-Muster wie customers/projects/devices: angemeldet
      // + eigene companyId. Lesen ist für alle Unternehmensmitglieder gedacht
      // (siehe docs/database/permissions.md, "Proben ansehen" ist bei allen
      // 5 Kernrollen erlaubt); Schreiben ist heute ebenfalls für jeden
      // angemeldeten Nutzer der eigenen Firma offen, da noch keine Custom
      // Claims für eine rollenabhängige Einschränkung existieren. Laut
      // Rechte-Matrix dürfen Proben zwar von (fast) allen Rollen erstellt/
      // bearbeitet werden, aber laut Sprint-Vorgabe NICHT von der Azubi-Rolle
      // endgültig gelöscht werden (siehe docs/database/permissions.md,
      // Regel 1) – diese feingranulare Durchsetzung ist ohne Custom Claims
      // (Rolle im Auth-Token) in Security Rules nicht möglich und daher noch
      // nicht umgesetzt (siehe docs/firebase/sample-firestore-slice.md,
      // "Bekannte offene Punkte"). Bis dahin bewusst restriktiv auf "eigene
      // Firma", nicht auf "jeder darf alles".
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/testValues/{testValueId} {
      // Gleiches companyId-Muster wie customers/projects/devices/samples:
      // angemeldet + eigene companyId. Lesen ist für alle
      // Unternehmensmitglieder gedacht (siehe docs/database/permissions.md,
      // "Prüfungen ansehen/erstellen/bearbeiten" ist bei Admin/Laborleiter/
      // Prüfer erlaubt, Azubi/Gast nur ansehen); Schreiben ist heute
      // ebenfalls für jeden angemeldeten Nutzer der eigenen Firma offen, da
      // noch keine Custom Claims für eine rollenabhängige Einschränkung
      // existieren. Bis dahin bewusst restriktiv auf "eigene Firma", nicht
      // auf "jeder darf alles" (siehe
      // docs/firebase/test-values-firestore-slice.md, "Bekannte offene
      // Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/reports/{reportId} {
      // Gleiches companyId-Muster wie customers/projects/devices/samples/
      // testValues: angemeldet + eigene companyId. Lesen ist für alle
      // Unternehmensmitglieder gedacht; Schreiben ist heute ebenfalls für
      // jeden angemeldeten Nutzer der eigenen Firma offen, da noch keine
      // Custom Claims für eine rollenabhängige Einschränkung existieren.
      // Bis dahin bewusst restriktiv auf "eigene Firma", nicht auf "jeder
      // darf alles" (siehe docs/firebase/report-firestore-slice.md,
      // "Bekannte offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/calendarEvents/{eventId} {
      // Gleiches companyId-Muster wie customers/projects/devices/samples/
      // testValues/reports: angemeldet + eigene companyId. Keine Rollen- oder
      // Claims-Logik (siehe docs/firebase/calendar-firestore-slice.md,
      // "Offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/laborbook/{entryId} {
      // Gleiches companyId-Muster wie die übrigen Slices: angemeldet + eigene
      // companyId. Keine Rollen- oder Claims-Logik (siehe
      // docs/firebase/laborbook-firestore-slice.md, "Offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/locations/{locationId} {
      // Gleiches companyId-Muster wie die übrigen Slices: angemeldet + eigene
      // companyId. Keine Rollen- oder Claims-Logik (siehe
      // docs/firebase/location-firestore-slice.md, "Offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/employees/{employeeId} {
      // Gleiches companyId-Muster wie die übrigen Slices: angemeldet + eigene
      // companyId. Das Feld "role" eines Mitarbeiters steuert hier ausdrücklich
      // KEINE Firestore-Rechte (keine Rollen-/Claims-Logik; siehe
      // docs/firebase/employee-firestore-slice.md, "Offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/invitations/{invitationId} {
      // Gleiches companyId-Muster wie die übrigen Slices: angemeldet + eigene
      // companyId. Keine Rollen- oder Claims-Logik. Einladungen sind reine
      // Metadaten; das Dokument enthält weder Token noch Link (siehe
      // docs/firebase/invitation-firestore-slice.md, "Offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/roles/{roleId} {
      // Gleiches companyId-Muster wie die übrigen Slices: angemeldet + eigene
      // companyId. Rollen-Dokumente werden hier AUSDRÜCKLICH NICHT ausgewertet:
      // keine dynamische Role-Abfrage, keine Claims-Logik. Sie sind
      // Verwaltungsdaten; die serverseitige Durchsetzung folgt in einem späteren
      // Security-Slice (siehe docs/firebase/role-firestore-slice.md, "Offene
      // Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    // Alles andere ist heute nicht Teil dieser Slices und bleibt gesperrt,
    // bis es explizit angebunden und mit eigenen Regeln versehen wird.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
