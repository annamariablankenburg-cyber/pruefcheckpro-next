rules_version = '2';

// Security Rules für die real angebundenen Vertical Slices (Kunden, Projekte,
// Geräte, Proben, Prüfwerte, Berichte, Kalender, Laborbuch, Standorte,
// Mitarbeiter, Einladungen, Rollen; siehe docs/firebase/*-firestore-slice.md).
// Bewusst restriktiv: nur Collections mit echter Firestore-Anbindung werden
// geöffnet, alles andere bleibt per Fallback gesperrt. Kein
// "allow read, write: if true" irgendwo in diesem Projekt.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Security Foundations (siehe docs/firebase/security-foundations.md) ---
    //
    // Die Firmenzugehörigkeit kommt AUSSCHLIESSLICH aus
    // userMemberships/{request.auth.uid}. users/{uid} ist das clientseitig
    // verwaltete Login-Profil; dessen Felder (role, companyId, plan …) werden
    // hier NIE für die Autorisierung ausgewertet.
    //
    // Zugriff auf companies/{companyId}/... nur, wenn
    //   - der Nutzer angemeldet ist,
    //   - ein Membership-Dokument existiert,
    //   - membership.companyId == companyId UND
    //   - membership.status == "Aktiv".
    // Fehlende Felder führen über .get(key, default) zu "kein Zugriff", nie zu
    // einem Fehler mit Fallback. Das Membership-Dokument wird pro Request nur
    // einmal gelesen (wiederholte get() auf dasselbe Dokument zählen einmal).
    //
    // Rollenbasierte Durchsetzung für ALLE zwölf Company-Collections:
    //  - PHASE 1 (docs/firebase/role-permission-rules-phase1.md): roles,
    //    employees, invitations, locations,
    //  - PHASE 2 (docs/firebase/role-permission-rules-phase2.md): die acht
    //    Fach-Collections customers, projects, devices, samples, testValues,
    //    reports, calendarEvents, laborbook (je *.ansehen / *.erstellen /
    //    *.bearbeiten / *.loeschen).
    // Es gibt keine Collection mehr, die nur "aktive Membership der Firma" prüft.
    //
    // Autorisierung: ausschließlich userMemberships/{uid}.roleId -> das
    // Role-Dokument companies/{companyId}/roles/{roleId} -> permissions[key].
    // NICHT ausgewertet werden users/{uid}.role und der Snapshot
    // membership.role. Fehlt irgendein Glied der Kette (Membership, roleId,
    // Role-Dokument, aktive Rolle, permissions-Map, Schlüssel) oder ist der Wert
    // nicht exakt true, ist das Ergebnis "kein Recht" – es gibt keinen
    // Admin-/Demo-Fallback.
    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath() {
      return /databases/$(database)/documents/userMemberships/$(request.auth.uid);
    }

    // Nur nach hasActiveMembership() aufrufen (setzt ein vorhandenes Dokument voraus).
    function currentMembership() {
      return get(membershipPath()).data;
    }

    function hasActiveMembership(companyId) {
      return isSignedIn() &&
        exists(membershipPath()) &&
        currentMembership().get("companyId", "") == companyId &&
        currentMembership().get("status", "") == "Aktiv";
    }

    function rolePath(companyId, roleId) {
      return /databases/$(database)/documents/companies/$(companyId)/roles/$(roleId);
    }

    // roleId der aktuellen Membership (nur nach hasActiveMembership()).
    function currentRoleId() {
      return currentMembership().get("roleId", "");
    }

    // Wert eines Schlüssels in einem Role-Dokument (Map "data"). Fehlt die
    // permissions-Map oder der Schlüssel: false. Nur exakt true gewährt.
    function roleGrants(roleData, permissionKey) {
      return "permissions" in roleData &&
        roleData.permissions.get(permissionKey, false) == true;
    }

    // 1. angemeldet  2. aktive Membership derselben Firma  3. nichtleere roleId
    // 4. Role-Dokument existiert  5. Rolle ist "Aktiv"  6. Schlüssel == true.
    function hasPermission(companyId, permissionKey) {
      return hasActiveMembership(companyId) &&
        currentRoleId() is string &&
        currentRoleId() != "" &&
        exists(rolePath(companyId, currentRoleId())) &&
        get(rolePath(companyId, currentRoleId())).data.get("status", "") == "Aktiv" &&
        roleGrants(get(rolePath(companyId, currentRoleId())).data, permissionKey);
    }

    // Restricted-Schlüssel (Superuser-/Administratorrechte). BEWUSST hier
    // gespiegelt (Rules kennen keine TypeScript-Konstanten); Quelle:
    // RESTRICTED_PERMISSION_KEYS in src/config/roles.ts. Ein Test
    // (tests/firestore/restricted-keys-sync.test.ts) prüft die Übereinstimmung.
    function roleHasRestrictedKey(roleData) {
      return roleGrants(roleData, "rollen.admin_verwalten") ||
        roleGrants(roleData, "administration.branding_aendern") ||
        roleGrants(roleData, "administration.abrechnung_verwalten") ||
        roleGrants(roleData, "administration.systemeinstellungen_aendern");
    }

    // Hat sich der Wert irgendeines Restricted-Schlüssels geändert? Verglichen
    // wird der WIRKSAME Wert (fehlend == false), nicht das Vorhandensein.
    function restrictedKeyChanged(newRole, oldRole) {
      return roleGrants(newRole, "rollen.admin_verwalten") != roleGrants(oldRole, "rollen.admin_verwalten") ||
        roleGrants(newRole, "administration.branding_aendern") != roleGrants(oldRole, "administration.branding_aendern") ||
        roleGrants(newRole, "administration.abrechnung_verwalten") != roleGrants(oldRole, "administration.abrechnung_verwalten") ||
        roleGrants(newRole, "administration.systemeinstellungen_aendern") != roleGrants(oldRole, "administration.systemeinstellungen_aendern");
    }

    // ROLLEN-SCHUTZ: Zusätzlich zu den Restricted-Schlüsseln sind die drei
    // Admin-only-Löschrechte geschützt (Geräte, Laborbuch, Berichte; Policy in
    // docs/database/permissions.md). Sie bleiben fachlich "destructive", dürfen
    // aber – wie Restricted – beim Anlegen/Ändern einer Rolle nur mit
    // rollen.admin_verwalten vergeben oder entzogen werden. Quelle:
    // ADMIN_ONLY_DELETE_PERMISSION_KEYS / PROTECTED_ROLE_PERMISSION_KEYS in
    // src/config/roles.ts (Test: tests/firestore/rules-config-sync.test.ts).
    // Normale Löschrechte (proben., pruefungen., kunden., projekte., kalender.)
    // sind NICHT geschützt und bleiben für den Laborleiter vergebbar.
    function roleHasAdminOnlyDeleteKey(roleData) {
      return roleGrants(roleData, "geraete.loeschen") ||
        roleGrants(roleData, "laborbuch.loeschen") ||
        roleGrants(roleData, "berichte.loeschen");
    }

    function adminOnlyDeleteKeyChanged(newRole, oldRole) {
      return roleGrants(newRole, "geraete.loeschen") != roleGrants(oldRole, "geraete.loeschen") ||
        roleGrants(newRole, "laborbuch.loeschen") != roleGrants(oldRole, "laborbuch.loeschen") ||
        roleGrants(newRole, "berichte.loeschen") != roleGrants(oldRole, "berichte.loeschen");
    }

    // Geschützt = Restricted ODER Admin-only-Löschrecht (nur für Rollen anlegen/ändern).
    function roleHasProtectedKey(roleData) {
      return roleHasRestrictedKey(roleData) || roleHasAdminOnlyDeleteKey(roleData);
    }

    function protectedKeyChanged(newRole, oldRole) {
      return restrictedKeyChanged(newRole, oldRole) || adminOnlyDeleteKeyChanged(newRole, oldRole);
    }

    // Eine permissions-Map darf AUSSCHLIESSLICH die 45 aktuell bekannten Schlüssel
    // enthalten (Spiegel von allPermissionKeys in src/config/roles.ts; Test:
    // tests/firestore/rules-config-sync.test.ts). Hintergrund: Ein heute
    // gespeicherter unbekannter Schlüssel mit true könnte in einem späteren
    // Release zu einer echten Berechtigung werden (Future-Privilege-Risk).
    // Fehlende bekannte Schlüssel sind erlaubt und gelten als false
    // (Legacy-Rollen mit nur den 31 alten Schlüsseln bleiben gültig); es gibt keine
    // Pflicht, alle 45 zu speichern. Fehlt permissions ganz, gibt es nichts zu prüfen
    // (die Create-Regel verlangt die Map separat).
    function hasOnlyKnownPermissionKeys(roleData) {
      return !("permissions" in roleData) ||
        (roleData.permissions is map &&
         roleData.permissions.keys().hasOnly([
        "dashboard.anzeigen",
        "proben.ansehen",
        "proben.erstellen",
        "proben.bearbeiten",
        "proben.loeschen",
        "pruefungen.ansehen",
        "pruefungen.erstellen",
        "pruefungen.bearbeiten",
        "pruefungen.loeschen",
        "kunden.ansehen",
        "kunden.erstellen",
        "kunden.bearbeiten",
        "kunden.loeschen",
        "projekte.ansehen",
        "projekte.erstellen",
        "projekte.bearbeiten",
        "projekte.loeschen",
        "geraete.ansehen",
        "geraete.erstellen",
        "geraete.bearbeiten",
        "geraete.loeschen",
        "laborbuch.ansehen",
        "laborbuch.erstellen",
        "laborbuch.bearbeiten",
        "laborbuch.loeschen",
        "kalender.ansehen",
        "kalender.termine_erstellen",
        "kalender.bearbeiten",
        "kalender.loeschen",
        "berichte.ansehen",
        "berichte.erstellen",
        "berichte.bearbeiten",
        "berichte.loeschen",
        "pdf.exportieren",
        "ki.verwenden",
        "standorte.ansehen",
        "mitarbeiter.ansehen",
        "rollen.ansehen",
        "administration.mitarbeiter_verwalten",
        "administration.rollen_verwalten",
        "administration.standorte_verwalten",
        "administration.branding_aendern",
        "administration.abrechnung_verwalten",
        "administration.systemeinstellungen_aendern",
        "rollen.admin_verwalten"
         ]));
    }

    // "Geschützte Rolle" im Sinne der Zuweisungs-/Änderungsregeln (Mitarbeiter,
    // Einladungen): die Administrator-Rolle, jede Rolle (System-, Custom- oder
    // archivierte Rolle), die IRGENDEINEN der 7 geschützten Schlüssel enthält
    // (4 Restricted + 3 Admin-only-Löschrechte) – und fail-closed alles, was sich
    // nicht auflösen lässt (fehlende/leere/unbekannte roleId). Eine solche Rolle
    // darf nur mit rollen.admin_verwalten zugewiesen oder beim Ziel geändert werden.
    function roleIdIsProtected(companyId, roleId) {
      return !(roleId is string) ||
        roleId == "" ||
        roleId == "admin" ||
        !exists(rolePath(companyId, roleId)) ||
        roleHasProtectedKey(get(rolePath(companyId, roleId)).data);
    }

    // Stabile IDs der Systemrollen (Spiegel von SYSTEM_ROLE_IDS in
    // src/config/roles.ts; vom Test geprüft). Als benutzerdefinierte Rolle
    // dürfen diese IDs nie angelegt werden.
    function isSystemRoleId(roleId) {
      return roleId in ["admin", "laborleiter", "pruefer", "azubi", "gast"];
    }

    // Eigenes Dokument über die Membership-Verknüpfung (nie über Name/E-Mail).
    // (Nur zum Lesen; das Ändern von Rolle/Status ist für alle Clients gesperrt.)
    function isOwnEmployee(companyId, employeeId) {
      return hasActiveMembership(companyId) &&
        employeeId != "" &&
        currentMembership().get("employeeId", "") == employeeId;
    }

    function isOwnRole(companyId, roleId) {
      return hasActiveMembership(companyId) &&
        roleId != "" &&
        currentRoleId() == roleId;
    }

    // Berichte: Export-Status (Spiegel von ReportStatus in src/types/report.ts).
    function reportIsExported(reportData) {
      return reportData.get("status", "") in ["PDF exportiert", "Excel exportiert"];
    }

    // Ein Update setzt den Bericht NEU in einen Export-Status (Wechsel, nicht jede
    // Änderung an einem bereits exportierten Bericht).
    function reportExportStatusEntered() {
      return reportIsExported(request.resource.data) &&
        request.resource.data.get("status", "") != resource.data.get("status", "");
    }

    // Sicherheitsrelevante Felder eines Mitarbeiters: roleId, role (Namens-Snapshot)
    // und status. Sie dürfen vom CLIENT NIE geändert werden (auch nicht vom
    // Administrator und nicht am eigenen Dokument): Die Änderung muss Mitarbeiter UND
    // Membership gemeinsam betreffen und läuft deshalb ausschließlich serverseitig
    // (Admin SDK, siehe docs/firebase/member-security-actions.md; das Admin SDK
    // umgeht die Rules). Erfasst werden auch Hinzufügen und Entfernen
    // (deleteField) der Felder.
    function changesServerOnlyEmployeeFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(["roleId", "role", "status"]);
    }

    // Form-Prüfung für Rollen-Updates (ohne die Berechtigungsprüfung): type und
    // createdAt unverändert; Systemrollen nur permissions/updatedAt, andere
    // Rollen nur name/description/color/permissions/status/updatedAt; status
    // bleibt "Aktiv"/"Archiviert".
    function isValidRoleUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isSystem = resource.data.get("type", "") == "System";
      return !changed.hasAny(["type", "createdAt"]) &&
        request.resource.data.get("status", "") in ["Aktiv", "Archiviert"] &&
        ((isSystem && changed.hasOnly(["permissions", "updatedAt"])) ||
         (!isSystem && changed.hasOnly(["name", "description", "color", "permissions", "status", "updatedAt"])));
    }

    // Membership-Dokument: der eigene Nutzer darf es LESEN (einzelnes Dokument,
    // kein Auflisten). Es gibt KEINEN Client-Write (create/update/delete): die
    // Zuordnung zu Firma/Mitarbeiter/Rolle/Status wird nicht von der App
    // gesetzt. Rolle und Status ändert ausschließlich der Server (Admin SDK, umgeht
    // die Rules): assignRole/setMemberStatus, siehe
    // docs/firebase/member-security-actions.md. Provisionierung (Einladung annehmen,
    // Firma anlegen) ist noch nicht implementiert. Im lokalen Emulator seeden
    // siehe scripts/seedUserMemberships.ts.
    match /userMemberships/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Login-Profil (AppUser, siehe src/lib/firebase/users.ts). KEINE
    // Sicherheitsquelle: Felder wie role/plan/companyId werden nirgends für die
    // Autorisierung ausgewertet (siehe oben). Trotzdem sind role/plan
    // Produkt-/Profilmetadaten und daher für den Client nicht frei änderbar.
    //
    // Der Client braucht genau zwei Schreibvorgänge (users.ts):
    //   1. createUserProfile(): einmalig bei der Registrierung ein festes
    //      Basisprofil (role "azubi", plan "azubi", serverTimestamp für
    //      createdAt/lastLogin),
    //   2. updateLastLogin(): beim Login NUR lastLogin.
    // Deshalb: Einzeldokument-Lesen nur für den eigenen User (kein list), Create
    // nur mit exakt diesem Basismodell, Update nur lastLogin, kein Löschen.
    // firstName/lastName/language/theme werden heute clientseitig nirgends
    // geändert und sind deshalb nicht änderbar; email ebenso (kein Profil-Sync).
    function isValidNewProfile(uid) {
      let fields = ["id", "firstName", "lastName", "email", "role", "plan",
                    "language", "theme", "createdAt", "lastLogin"];
      let data = request.resource.data;
      return data.keys().hasOnly(fields) &&
        data.keys().hasAll(fields) &&
        data.id == uid &&
        data.firstName is string &&
        data.lastName is string &&
        data.email is string &&
        data.role == "azubi" &&
        data.plan == "azubi" &&
        data.language in ["de", "en"] &&
        data.theme in ["light", "dark", "system"] &&
        data.createdAt == request.time &&
        data.lastLogin == request.time;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == uid && isValidNewProfile(uid);
      // Nur lastLogin darf sich ändern (und nur auf die Serverzeit). id, email,
      // role, plan, companyId, laboratoryId, createdAt, firstName, lastName,
      // language, theme bleiben unveränderlich.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastLogin"]) &&
        request.resource.data.lastLogin == request.time;
      allow delete: if false;
    }

    // --- Fach-Collections (PHASE 2, docs/firebase/role-permission-rules-phase2.md) ---
    //
    // Jede Operation prüft hasPermission(companyId, <Schlüssel>): aktive Membership
    // der Firma im Pfad (Tenant-Isolation) -> membership.roleId -> Rolle derselben
    // Firma mit status "Aktiv" -> permissions[<Schlüssel>] == true. Fehlt ein
    // Glied der Kette oder der Schlüssel (z. B. in Rollen vor der 31->45-Migration),
    // ist das Ergebnis DENY. Die Schlüssel stammen ausschließlich aus
    // src/config/roles.ts (Test: tests/firestore/rules-config-sync.test.ts).
    //
    // Einheitliches Muster je Collection:
    //   get, list  -> <bereich>.ansehen
    //   create     -> <bereich>.erstellen   (Kalender: kalender.termine_erstellen)
    //   update     -> <bereich>.bearbeiten  (Statuswechsel/Archivieren/Deaktivieren
    //                                        sind Updates: es gibt kein eigenes Recht)
    //   delete     -> <bereich>.loeschen    (eigenständig, nie aus bearbeiten abgeleitet)
    // geraete.loeschen, laborbuch.loeschen und berichte.loeschen sind Admin-only-
    // Löschrechte: ihre Vergabe ist in den Rollen-Rules geschützt, hier wird nur
    // der gespeicherte Wert über hasPermission() ausgewertet.
    //
    // Es gibt KEINE zusätzliche Lese-Pflicht für Schreibvorgänge: ein Recht zum
    // Erstellen/Bearbeiten verlangt die Rules nicht auch *.ansehen (der Client-
    // Service liest allerdings vor/nach dem Schreiben, siehe Doku).
    // Referenzfelder (customerId, projectId, sampleId, deviceId, locationId, ...) sind
    // reine Firmen-IDs ohne Pfad: sie werden nur innerhalb von companies/{companyId}
    // aufgelöst, eine Fremd-Referenz legt nichts offen. Es gibt deshalb bewusst keine
    // exists()-Prüfungen (Details in der Doku); die einzige strukturelle Prüfung ist
    // sampleId == Dokument-ID bei testValues.

    match /companies/{companyId}/customers/{customerId} {
      allow get, list: if hasPermission(companyId, "kunden.ansehen");
      allow create: if hasPermission(companyId, "kunden.erstellen");
      allow update: if hasPermission(companyId, "kunden.bearbeiten");
      allow delete: if hasPermission(companyId, "kunden.loeschen");
    }

    match /companies/{companyId}/projects/{projectId} {
      allow get, list: if hasPermission(companyId, "projekte.ansehen");
      allow create: if hasPermission(companyId, "projekte.erstellen");
      allow update: if hasPermission(companyId, "projekte.bearbeiten");
      allow delete: if hasPermission(companyId, "projekte.loeschen");
    }

    match /companies/{companyId}/devices/{deviceId} {
      allow get, list: if hasPermission(companyId, "geraete.ansehen");
      allow create: if hasPermission(companyId, "geraete.erstellen");
      allow update: if hasPermission(companyId, "geraete.bearbeiten");
      allow delete: if hasPermission(companyId, "geraete.loeschen");
    }

    match /companies/{companyId}/samples/{sampleId} {
      allow get, list: if hasPermission(companyId, "proben.ansehen");
      allow create: if hasPermission(companyId, "proben.erstellen");
      allow update: if hasPermission(companyId, "proben.bearbeiten");
      allow delete: if hasPermission(companyId, "proben.loeschen");
    }

    // Prüfwerte gehören zu den Prüfungen (pruefungen.*). Die Dokument-ID ist die
    // Probennummer (createTestEntry schreibt unter sampleId): das Feld sampleId
    // muss beim Anlegen der Dokument-ID entsprechen und ist danach unveränderlich.
    // Damit lässt sich keine abweichende Probenreferenz einschleusen.
    match /companies/{companyId}/testValues/{testValueId} {
      allow get, list: if hasPermission(companyId, "pruefungen.ansehen");
      allow create: if hasPermission(companyId, "pruefungen.erstellen") &&
        request.resource.data.get("sampleId", "") == testValueId;
      allow update: if hasPermission(companyId, "pruefungen.bearbeiten") &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["sampleId"]);
      allow delete: if hasPermission(companyId, "pruefungen.loeschen");
    }

    // Berichte: Der Wechsel in einen Export-Status ("PDF exportiert", "Excel
    // exportiert") ist die Aktion "exportieren" und verlangt zusätzlich
    // pdf.exportieren (Policy: docs/database/permissions.md, Abschnitt 5). Das gilt
    // auch beim Anlegen mit einem Export-Status.
    match /companies/{companyId}/reports/{reportId} {
      allow get, list: if hasPermission(companyId, "berichte.ansehen");
      allow create: if hasPermission(companyId, "berichte.erstellen") &&
        (!reportIsExported(request.resource.data) || hasPermission(companyId, "pdf.exportieren"));
      allow update: if hasPermission(companyId, "berichte.bearbeiten") &&
        (!reportExportStatusEntered() || hasPermission(companyId, "pdf.exportieren"));
      allow delete: if hasPermission(companyId, "berichte.loeschen");
    }

    // Kalender: der Schlüssel zum Anlegen heißt (Legacy-Name) kalender.termine_erstellen.
    match /companies/{companyId}/calendarEvents/{eventId} {
      allow get, list: if hasPermission(companyId, "kalender.ansehen");
      allow create: if hasPermission(companyId, "kalender.termine_erstellen");
      allow update: if hasPermission(companyId, "kalender.bearbeiten");
      allow delete: if hasPermission(companyId, "kalender.loeschen");
    }

    match /companies/{companyId}/laborbook/{entryId} {
      allow get, list: if hasPermission(companyId, "laborbuch.ansehen");
      allow create: if hasPermission(companyId, "laborbuch.erstellen");
      allow update: if hasPermission(companyId, "laborbuch.bearbeiten");
      allow delete: if hasPermission(companyId, "laborbuch.loeschen");
    }

    match /companies/{companyId}/locations/{locationId} {
      // Rollenbasiert (Phase 1, docs/firebase/role-permission-rules-phase1.md).
      // Lesen: standorte.ansehen. Anlegen/Ändern (inkl. Deaktivieren/
      // Reaktivieren): administration.standorte_verwalten. Löschen nie – Standorte
      // werden über den Status "Inaktiv" deaktiviert.
      allow get, list: if hasPermission(companyId, "standorte.ansehen");
      allow create, update: if hasPermission(companyId, "administration.standorte_verwalten");
      allow delete: if false;
    }

    match /companies/{companyId}/employees/{employeeId} {
      // Rollenbasiert (Phase 1). Lesen: mitarbeiter.ansehen; zusätzlich darf
      // jeder aktive User SEIN eigenes Dokument einzeln lesen (Membership.
      // employeeId == Dokument-ID, kein Abgleich über Name/E-Mail; kein list).
      allow get: if hasPermission(companyId, "mitarbeiter.ansehen") || isOwnEmployee(companyId, employeeId);
      allow list: if hasPermission(companyId, "mitarbeiter.ansehen");

      // Anlegen: in Phase 1 nie vom Client (kommt später serverseitig, z. B.
      // Einladungsannahme). Löschen nie (Status "Gesperrt").
      allow create: if false;
      allow delete: if false;

      // Ändern: administration.mitarbeiter_verwalten, aber
      //  - NIE die sicherheitsrelevanten Felder roleId, role und status: Rolle ändern,
      //    sperren und reaktivieren laufen ausschließlich serverseitig (Employee +
      //    Membership atomar, mit Prüfung von geschützten Rollen, Eigenänderung und
      //    letztem Administrator). Das gilt für ALLE Clients, auch den Administrator.
      //  - nie ein Mitarbeiter, dessen aktuelle Rolle die Administrator-Rolle / eine
      //    Rolle mit geschütztem Schlüssel (Restricted oder Admin-only-Löschrecht) /
      //    nicht auflösbar ist, ohne zusätzlich rollen.admin_verwalten.
      // Erlaubt bleiben unkritische Felder (Standort, Kontaktdaten, Historie …).
      allow update: if hasPermission(companyId, "administration.mitarbeiter_verwalten") &&
        !changesServerOnlyEmployeeFields() &&
        (hasPermission(companyId, "rollen.admin_verwalten") ||
          !roleIdIsProtected(companyId, resource.data.get("roleId", "")));
    }

    match /companies/{companyId}/invitations/{invitationId} {
      // Rollenbasiert (Phase 1). Lesen/Anlegen/Widerrufen:
      // administration.mitarbeiter_verwalten. Löschen nie (Widerruf statt Löschen).
      allow get, list: if hasPermission(companyId, "administration.mitarbeiter_verwalten");

      // Anlegen: nur als "Ausstehend" (Annahme gibt es nur serverseitig), ohne
      // acceptedAt/revokedAt. Eine Einladung für die Administrator-Rolle, eine
      // Rolle mit geschütztem Schlüssel (Restricted oder Admin-only-Löschrecht) oder
      // eine nicht auflösbare Rolle erfordert
      // zusätzlich rollen.admin_verwalten.
      allow create: if hasPermission(companyId, "administration.mitarbeiter_verwalten") &&
        request.resource.data.get("status", "") == "Ausstehend" &&
        !request.resource.data.keys().hasAny(["acceptedAt", "revokedAt"]) &&
        (hasPermission(companyId, "rollen.admin_verwalten") ||
          !roleIdIsProtected(companyId, request.resource.data.get("roleId", "")));

      // Ändern: ausschließlich der Widerruf (der einzige Update-Pfad des
      // Services): Ausstehend -> Widerrufen, nur status/revokedAt/updatedAt.
      allow update: if hasPermission(companyId, "administration.mitarbeiter_verwalten") &&
        resource.data.get("status", "") == "Ausstehend" &&
        request.resource.data.get("status", "") == "Widerrufen" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "revokedAt", "updatedAt"]);

      allow delete: if false;
    }

    match /companies/{companyId}/roles/{roleId} {
      // Rollenbasiert (Phase 1). Lesen: rollen.ansehen; zusätzlich darf jeder
      // aktive User SEINE EIGENE Rolle (Membership.roleId == Dokument-ID)
      // einzeln lesen, damit er seine wirksamen Berechtigungen laden kann.
      allow get: if hasPermission(companyId, "rollen.ansehen") || isOwnRole(companyId, roleId);
      allow list: if hasPermission(companyId, "rollen.ansehen");

      // Anlegen: administration.rollen_verwalten, nur benutzerdefiniert und
      // aktiv, nie mit der ID einer Systemrolle, mit permissions-Map (nur bekannte
      // Schlüssel, siehe hasOnlyKnownPermissionKeys), und ohne
      // geschützte Schlüssel (Restricted + Admin-only-Löschrechte), außer der
      // User hat rollen.admin_verwalten.
      allow create: if hasPermission(companyId, "administration.rollen_verwalten") &&
        !isSystemRoleId(roleId) &&
        request.resource.data.get("type", "") == "Benutzerdefiniert" &&
        request.resource.data.get("status", "") == "Aktiv" &&
        "permissions" in request.resource.data &&
        request.resource.data.permissions is map &&
        hasOnlyKnownPermissionKeys(request.resource.data) &&
        (hasPermission(companyId, "rollen.admin_verwalten") ||
          !roleHasProtectedKey(request.resource.data));

      // Ändern: administration.rollen_verwalten. Die Administrator-Rolle ist für
      // ALLE (auch den Administrator) unveränderlich. type und createdAt sind
      // unveränderlich. Systemrollen: nur permissions (+ updatedAt). Benutzer-
      // definierte Rollen: name, description, color, permissions, status.
      // Änderungen an geschützten Schlüsseln (Restricted + Admin-only-Löschrechte;
      // Vergabe UND Entzug) erfordern rollen.admin_verwalten.
      allow update: if hasPermission(companyId, "administration.rollen_verwalten") &&
        roleId != "admin" &&
        hasOnlyKnownPermissionKeys(request.resource.data) &&
        isValidRoleUpdate() &&
        (!protectedKeyChanged(request.resource.data, resource.data) ||
          hasPermission(companyId, "rollen.admin_verwalten"));

      // Rollen werden nie gelöscht (Archivieren statt Löschen).
      allow delete: if false;
    }

    // Alles andere ist heute nicht Teil dieser Slices und bleibt gesperrt,
    // bis es explizit angebunden und mit eigenen Regeln versehen wird.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
