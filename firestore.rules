rules_version = '2';

// Security Rules für die bereits real angebundenen Vertical Slices (siehe
// docs/firebase/customer-firestore-slice.md,
// docs/firebase/project-firestore-slice.md und
// docs/firebase/device-firestore-slice.md). Bewusst restriktiv: nur
// Collections mit echter Firestore-Anbindung werden geöffnet, alles andere
// bleibt per Fallback gesperrt. Kein "allow read, write: if true" irgendwo
// in diesem Projekt.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // companyId liegt heute als Feld auf users/{uid} (AppUser.companyId, siehe
    // src/types/user.ts), nicht als Firebase-Auth-Custom-Claim – deshalb ein
    // get()-Lookup statt request.auth.token.companyId. Sobald Custom Claims
    // für companyId/Rolle eingeführt werden (siehe docs/database/permissions.md,
    // Abschnitt 5 "Durchsetzung: UI vs. Firestore Security Rules"), kann das
    // hier ohne zusätzliche Leseoperation aus request.auth.token.companyId
    // gelesen werden.
    function belongsToCompany(companyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    match /companies/{companyId}/customers/{customerId} {
      // Angemeldet + eigene companyId. Keine rollenabhängige Einschränkung
      // (Admin/Laborleiter vs. Prüfer/Azubi/Gast, siehe
      // docs/database/permissions.md Abschnitt 3 "Kunden erstellen/bearbeiten/
      // löschen") – dafür fehlen heute noch die Custom Claims. Bis dahin
      // bewusst restriktiv auf "eigene Firma", nicht auf "jeder darf alles"
      // (siehe docs/firebase/customer-firestore-slice.md, "Bekannte offene
      // Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/projects/{projectId} {
      // Gleiches Muster wie companies/{companyId}/customers: angemeldet +
      // eigene companyId. Lesen ist für alle Unternehmensmitglieder gedacht
      // (siehe docs/database/permissions.md, "Projekte ansehen" ist bei allen
      // 5 Kernrollen erlaubt); Schreiben ist heute ebenfalls für jeden
      // angemeldeten Nutzer der eigenen Firma offen, da noch keine Custom
      // Claims für eine rollenabhängige Einschränkung existieren (nur
      // Admin/Laborleiter dürften laut Rechte-Matrix erstellen/bearbeiten/
      // löschen). Bis dahin bewusst restriktiv auf "eigene Firma", nicht auf
      // "jeder darf alles" (siehe docs/firebase/project-firestore-slice.md,
      // "Bekannte offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    match /companies/{companyId}/devices/{deviceId} {
      // Gleiches companyId-Muster wie companies/{companyId}/customers und
      // .../projects: angemeldet + eigene companyId. Lesen ist für alle
      // Unternehmensmitglieder gedacht (siehe docs/database/permissions.md,
      // "Geräte ansehen" ist bei allen 5 Kernrollen erlaubt); Schreiben ist
      // heute ebenfalls für jeden angemeldeten Nutzer der eigenen Firma
      // offen, da noch keine Custom Claims für eine rollenabhängige
      // Einschränkung existieren (nur Admin/Laborleiter dürften laut
      // Rechte-Matrix Geräte bearbeiten). Bis dahin bewusst restriktiv auf
      // "eigene Firma", nicht auf "jeder darf alles" (siehe
      // docs/firebase/device-firestore-slice.md, "Bekannte offene Punkte").
      allow read, write: if belongsToCompany(companyId);
    }

    // Alles andere ist heute nicht Teil dieser Slices und bleibt gesperrt,
    // bis es explizit angebunden und mit eigenen Regeln versehen wird.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
